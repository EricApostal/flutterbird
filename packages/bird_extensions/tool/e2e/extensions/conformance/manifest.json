{
  "manifest_version": 2,
  "name": "__MSG_name__",
  "default_locale": "en",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "conformance@bird.test" } },
  "permissions": ["<all_urls>", "storage", "tabs", "webRequest", "webRequestBlocking", "webNavigation"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["*://127.0.0.1/page/*"], "js": ["start.js"], "run_at": "document_start" },
    { "matches": ["*://127.0.0.1/page/*"], "js": ["main_world.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["*://127.0.0.1/page/*"], "js": ["idle.js"], "css": ["style.css"], "run_at": "document_idle" },
    { "matches": ["*://127.0.0.1/page/*"], "js": ["blank.js"], "all_frames": true, "match_about_blank": true },
    { "matches": ["*://127.0.0.1/frame/*", "*://localhost/frame/*"], "js": ["frame.js"], "all_frames": true, "run_at": "document_start" }
  ],
  "web_accessible_resources": ["injected.js", "module.js", "overlay.html"]
}
